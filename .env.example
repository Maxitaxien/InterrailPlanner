# Copy to .env yourself. No provider keys are needed for core trip planning.
POSTGRES_PASSWORD=replace-with-strong-local-password
LLM_MODEL=qwen3:14b
LLM_TIMEOUT_SECONDS=90
LLM_FALLBACK_ENABLED=false
# Qwen3 14B Q4_K_M is a candidate for 16 GB VRAM; explicitly pull it first.
# Explicit overrides in .env or AI settings take precedence over the default.
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_THINKING=false
# City recommendations require SearXNG; opening saved ideas never searches.
# For a backend outside Docker only: SEARXNG_BASE_URL=http://127.0.0.1:8081
# compose.search.yaml requires a fresh signing secret (not a search API key).
SEARXNG_SECRET=
# Reserved for future authorized live adapters; no current code reads these keys.
OPENAI_API_KEY=
FLIGHT_API_KEY=
HOTEL_API_KEY=
# Used automatically when compose.motis.yaml is included. No API key needed.
MOTIS_TIMEOUT_SECONDS=30
# For a backend outside Docker only: MOTIS_BASE_URL=http://127.0.0.1:8080
# Host-only Swedish feed downloader. Never sent to the frontend/backend/MOTIS.
# Read only by an explicitly requested: python3 motis/download_sweden.py --refresh
TRAFIKLAB_GTFS_API_KEY=

# Optional on-demand rail research, after All Aboard approves your use/fees.
# Never put this key in NEXT_PUBLIC_ variables. Test is the default environment.
ALLABOARD_ENABLED=false
ALLABOARD_API_KEY=
ALLABOARD_ENVIRONMENT=test
ALLABOARD_TIMEOUT_SECONDS=30
# Denmark: obtain authorized GTFS archive at motis/downloads/denmark.zip.
# FerryhAPI: partner docs/authentication pending; no guessed key is consumed.
